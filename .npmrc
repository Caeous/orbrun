# Keep dev dependencies installed even when a build image sets NODE_ENV=production
# or NPM_CONFIG_PRODUCTION=true; without them there is no `vite` and no `wrangler`.
#
# This file is not enough on its own for Cloudflare. Cloudflare's build image sets
# NPM_CONFIG_INCLUDE=prod *and* NPM_CONFIG_OMIT=dev in the environment, and env
# config outranks a project .npmrc for the same key: `include` becomes ["prod"],
# `omit=dev` then applies, and the install stops at 8 packages with
# `sh: 1: vite: not found`. Only a CLI flag or a dashboard env var outranks that —
# see the build command in wrangler.jsonc. Verified against npm 10.9.2, the
# version the Cloudflare image reports.
include=dev
