{
  "name": "orbrun-monorepo",
  "private": true,
  "description": "Orbrun: Dungeon Crawl Stone Soup in first person, built for controllers and handhelds. The game plus the DCSS-as-a-library packages it is built on.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caeous/orbrun.git"
  },
  "homepage": "https://orbrun.app",
  "bugs": "https://github.com/Caeous/orbrun/issues",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/orbrun",
    "prebuild": "node tools/build/ensure-dev-deps.mjs",
    "build": "npm run build -w apps/orbrun",
    "preview": "npm run preview -w apps/orbrun",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "record": "node tools/record/record.mjs",
    "room:pack": "node tools/build/pack-room.mjs",
    "room:poster": "node tools/build/poster.mjs",
    "deploy": "wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "happy-dom": "^20.14.0",
    "opentype.js": "^2.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.129.0",
    "ws": "^8.18.0"
  }
}
