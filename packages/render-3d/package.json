{
  "name": "@orbrun/render-3d",
  "version": "0.1.0",
  "description": "First-person three.js renderer of an @orbrun/scene Scene",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Caeous/orbrun.git",
    "directory": "packages/render-3d"
  },
  "homepage": "https://github.com/Caeous/orbrun/tree/main/packages/render-3d",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./level-mesh": {
      "types": "./src/level-mesh.ts",
      "default": "./src/level-mesh.ts"
    },
    "./grid": {
      "types": "./src/grid.ts",
      "default": "./src/grid.ts"
    },
    "./sprites": {
      "types": "./src/sprites.ts",
      "default": "./src/sprites.ts"
    },
    "./hands": {
      "types": "./src/hands.ts",
      "default": "./src/hands.ts"
    },
    "./footprint": {
      "types": "./src/footprint.ts",
      "default": "./src/footprint.ts"
    },
    "./motion": {
      "types": "./src/motion.ts",
      "default": "./src/motion.ts"
    },
    "./peel": {
      "types": "./src/peel.ts",
      "default": "./src/peel.ts"
    }
  },
  "files": [
    "src"
  ],
  "dependencies": {
    "@orbrun/scene": "*"
  },
  "peerDependencies": {
    "three": ">=0.160"
  }
}
