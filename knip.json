{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/build/*.mjs",
        "engine/worker/index.ts"
      ]
    },
    "apps/orbrun": {
      "entry": [
        "testbed/*.ts",
        "worker/index.ts",
        "test/e2e/engine-worker.mjs"
      ]
    },
    "tools/record": {
      "entry": [
        "*.mjs"
      ]
    },
    "tools/term": {
      "entry": [
        "game/main.ts",
        "game/engine-worker.mjs"
      ],
      "ignoreDependencies": [
        "vite-node"
      ],
      "ignoreBinaries": [
        "ssh-keygen"
      ]
    },
    "packages/scene-webtiles": {
      "ignore": [
        "test/fixtures/**"
      ]
    }
  }
}
